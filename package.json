{
  "name": "@vinasig/totp-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Generate time-based verification codes locally without storing or sending secrets.",
  "repository": {
    "type": "git",
    "url": "https://github.com/VINASIG/totp-generator.git"
  },
  "homepage": "https://totp.vinasig.io.vn/",
  "bugs": {
    "url": "https://github.com/VINASIG/totp-generator/issues"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": "12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "node scripts/serve.ts --dist",
    "typecheck": "astro check --minimumFailingSeverity warning",
    "lint": "eslint src scripts tests *.mjs playwright.config.ts --max-warnings 0",
    "lint:css": "stylelint \"src/styles/**/*.css\" \"public/fonts/font.css\" --max-warnings 0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check:standards": "node scripts/check-standards.ts",
    "check:built": "node scripts/check-built.ts",
    "check": "npm run typecheck && npm run lint && npm run lint:css && npm run format:check && npm run check:standards && npm run check:licenses",
    "build": "astro build && node scripts/security.ts && npm run check:built && npm run check:licenses -- --built",
    "test": "node --test tests/*.test.ts",
    "test:browser": "npm run test:chrome && playwright test",
    "test:responsive": "playwright test --grep responsive",
    "test:performance": "node scripts/performance.ts && node scripts/performance.ts --english",
    "check:licenses": "node .vinasig/standards/templates/check-licenses.mjs",
    "test:chrome": "node tests/site-chrome.ts"
  },
  "dependencies": {
    "@lucide/astro": "1.52.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "html-validate": "11.16.2",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
